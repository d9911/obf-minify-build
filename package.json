{
  "name": "obf-minify-build",
  "version": "0.0.4-rc.3",
  "description": "Автоматизированная сборка фронтенда с минификацией, обфускацией и защитами. CLI и API.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "bin": {
    "obf-minify-build": "bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denis991/obf-minify-build.git"
  },
  "keywords": [
    "minify",
    "obfuscate",
    "build",
    "html",
    "css",
    "js",
    "cli",
    "protect",
    "frontend"
  ],
  "author": {
    "name": "Denis Gutsuliak",
    "email": "admin@d9911.org",
    "url": "https://t.me/d9911/"
  },
  "contributors": [
    {
      "name": "Denis Gutsuliak",
      "email": "admin@d9911.org",
      "url": "https://t.me/d9911/"
    }
  ],
  "license": "GPL-3.0-only-or-later",
  "files": [
    "README.md",
    "README.ru.md",
    "LICENSE",
    "lib/",
    "bin/",
    "config.mk",
    "Makefile",
    "obfuscator.json"
  ],
  "dependencies": {
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "javascript-obfuscator": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "autoprefixer": "^10.4.21",
    "clean-css-cli": "^5.6.3",
    "cssnano": "^7.1.0",
    "eslint": "^9.32.0",
    "glob": "^10.4.5",
    "globals": "^16.3.0",
    "htmlhint": "^1.6.3",
    "onchange": "^7.1.0",
    "postcss-cli": "^11.0.1",
    "replace-in-file": "^8.3.0",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^38.0.0"
  },
  "scripts": {
    "build": "node bin/cli.js",
    "dev": "onchange 'src/**/*' -- npm run build",
    "test": "node --test",
    "test:cli": "node --test test/cli.test.js",
    "test:package": "node --test test/package.test.js",
    "lint": "eslint bin lib scripts test src/js && stylelint \"src/css/**/*.css\" && htmlhint src/html"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    ">0.25%",
    "not dead"
  ],
  "homepage": "https://github.com/denis991/obf-minify-build#readme"
}
