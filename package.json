{
  "name": "obf-minify-build",
  "version": "0.0.4-rc.4",
  "description": "Zero-runtime-dependency static frontend builds with optional TypeScript, minification, inlining, and hashed assets.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "bin": {
    "obf-minify-build": "bin/cli.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/denis991/obf-minify-build.git"
  },
  "keywords": [
    "minify",
    "typescript",
    "build",
    "html",
    "css",
    "js",
    "cli",
    "protect",
    "frontend"
  ],
  "author": {
    "name": "Denis Gutsuliak",
    "email": "admin@d9911.org",
    "url": "https://t.me/d9911/"
  },
  "contributors": [
    {
      "name": "Denis Gutsuliak",
      "email": "admin@d9911.org",
      "url": "https://t.me/d9911/"
    }
  ],
  "license": "GPL-3.0-only",
  "files": [
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/README.md",
    "docs/EXAMPLES.md",
    "docs/TESTING.md",
    "docs/TROUBLESHOOTING.md",
    "lib/",
    "bin/",
    "config.mk",
    "Makefile",
    "obfuscator.json"
  ],
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.7.0",
    "glob": "^13.0.6",
    "globals": "^17.7.0",
    "htmlhint": "^1.9.2",
    "onchange": "^7.1.0",
    "playwright": "^1.61.1",
    "replace-in-file": "^8.4.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "build": "node bin/cli.js",
    "dev": "onchange 'src/**/*' -- npm run build",
    "test": "node --test test/*.test.js",
    "test:cli": "node --test test/cli.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "test:package": "node --test test/package.test.js",
    "lint": "eslint bin lib scripts test src/js && stylelint \"src/css/**/*.css\" && htmlhint src/html"
  },
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    ">0.25%",
    "not dead"
  ],
  "homepage": "https://github.com/denis991/obf-minify-build#readme"
}
